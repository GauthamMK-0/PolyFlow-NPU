// figA_homo_fission.dot
// Configuration A: Homogeneous-Dataflow Spatial Fission (Planaria / SARA Baseline)
// Render: dot -Tpng -Gdpi=160 figA_homo_fission.dot -o figA_homo_fission.png

digraph FIG_A {
  graph [fontname="Helvetica,Arial,sans-serif", rankdir=TB, compound=true,
         label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                 <TR><TD><FONT POINT-SIZE="16"><B>Configuration A: Homogeneous Spatial Fission Architecture</B></FONT></TD></TR>
                 <TR><TD><FONT POINT-SIZE="11" COLOR="#475569">Concurrent Multi-Tenancy with Array Pinned to Weight-Stationary (WS) Dataflow</FONT></TD></TR>
               </TABLE>>,
         labelloc=t, fontsize=14, pad=0.3, bgcolor="#FFFFFF"];

  node  [shape=box, style="rounded,filled", fontname="Helvetica,Arial,sans-serif", fontsize=10,
         fillcolor="#F8FAFC", color="#94A3B8", penwidth=1.2, margin="0.15,0.1"];
  edge  [fontname="Helvetica,Arial,sans-serif", fontsize=9, color="#475569", penwidth=1.2];

  // ==================== DISPATCH / CONTROLLER LAYER ====================
  subgraph cluster_dispatch {
    label=<<B>Host &amp; Dispatch Control Layer</B>>;
    fontsize=11; fontcolor="#1E293B";
    style="rounded,dashed"; color="#94A3B8"; bgcolor="#F1F5F9";

    host_ctrl   [label="Multi-Tenant Host Scheduler\n(Workload Queues A & B)", fillcolor="#FFFFFF", color="#64748B"];
    fiss_dec    [label="Spatial Fission Decoder\n(cfg_split_col = 8)\nEmits: region_id_mask", fillcolor="#EDE9FE", color="#7C3AED", fontcolor="#5B21B6"];

    host_ctrl -> fiss_dec [label=" Dispatch split"];
  }

  // ==================== COMPUTE SUBSTRATE LAYER ====================
  subgraph cluster_array {
    label=<<B>2D Systolic Compute Fabric (16×16 PE Mesh)</B>>;
    fontsize=12; fontcolor="#0F172A";
    style="rounded"; color="#64748B"; bgcolor="#FAFAFA";

    regA [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#0284C7">
        <TR><TD COLSPAN="4" BGCOLOR="#0284C7"><FONT COLOR="#FFFFFF" POINT-SIZE="10"><B>Region A Sub-Array (Cols 0–7)</B></FONT></TD></TR>
        <TR><TD COLSPAN="4" BGCOLOR="#E0F2FE"><FONT POINT-SIZE="9">Dataflow: <B>Weight-Stationary (WS)</B> [Pinned]</FONT></TD></TR>
        <TR><TD BGCOLOR="#FFFFFF">PE[0,0]</TD><TD BGCOLOR="#FFFFFF">PE[0,1]</TD><TD BGCOLOR="#FFFFFF">…</TD><TD BGCOLOR="#FFFFFF">PE[0,7]</TD></TR>
        <TR><TD BGCOLOR="#FFFFFF">PE[1,0]</TD><TD BGCOLOR="#FFFFFF">PE[1,1]</TD><TD BGCOLOR="#FFFFFF">…</TD><TD BGCOLOR="#FFFFFF">PE[1,7]</TD></TR>
        <TR><TD COLSPAN="4" BGCOLOR="#F0F9FF"><FONT POINT-SIZE="8" COLOR="#0369A1">Weights Stationary · Activations Stream W→E</FONT></TD></TR>
      </TABLE>>, fillcolor="#FFFFFF", shape=plaintext];

    boundary_gate [label=<
      <TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#DC2626">
        <TR><TD BGCOLOR="#FEE2E2"><FONT COLOR="#991B1B" POINT-SIZE="9"><B>BOUNDARY<BR/>ISOLATION<BR/>GATE</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#FEF2F2"><FONT POINT-SIZE="8" COLOR="#B91C1C">Wires<BR/>Zeroed<BR/>at Col 8</FONT></TD></TR>
      </TABLE>>, fillcolor="#FFFFFF", shape=plaintext];

    regB [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#059669">
        <TR><TD COLSPAN="4" BGCOLOR="#059669"><FONT COLOR="#FFFFFF" POINT-SIZE="10"><B>Region B Sub-Array (Cols 8–15)</B></FONT></TD></TR>
        <TR><TD COLSPAN="4" BGCOLOR="#ECFDF5"><FONT POINT-SIZE="9">Dataflow: <B>Weight-Stationary (WS)</B> [Pinned]</FONT></TD></TR>
        <TR><TD BGCOLOR="#FFFFFF">PE[0,8]</TD><TD BGCOLOR="#FFFFFF">PE[0,9]</TD><TD BGCOLOR="#FFFFFF">…</TD><TD BGCOLOR="#FFFFFF">PE[0,15]</TD></TR>
        <TR><TD BGCOLOR="#FFFFFF">PE[1,8]</TD><TD BGCOLOR="#FFFFFF">PE[1,9]</TD><TD BGCOLOR="#FFFFFF">…</TD><TD BGCOLOR="#FFFFFF">PE[1,15]</TD></TR>
        <TR><TD COLSPAN="4" BGCOLOR="#F0FDF4"><FONT POINT-SIZE="8" COLOR="#047857">Weights Stationary · Activations Stream W→E</FONT></TD></TR>
      </TABLE>>, fillcolor="#FFFFFF", shape=plaintext];

    {rank=same; regA; boundary_gate; regB;}
    regA -> boundary_gate [style=invis];
    boundary_gate -> regB [style=invis];
  }

  fiss_dec -> regA [label=" enable cols 0-7", color="#0284C7"];
  fiss_dec -> regB [label=" enable cols 8-15", color="#059669"];
  fiss_dec -> boundary_gate [label=" isolate boundary", color="#DC2626"];

  // ==================== SHARED MEMORY BANKS ====================
  subgraph cluster_banks {
    label=<<B>Shared Reconfigurable On-Chip Memory Subsystem</B>>;
    fontsize=11; fontcolor="#1E293B";
    style="rounded,dashed"; color="#D97706"; bgcolor="#FFFBEB";

    subgraph cluster_banks_A {
      label="Region A Allocated Banks"; color="#0284C7"; bgcolor="#F0F9FF";
      b0 [label="SRAM Bank 0\n[Weights A]", fillcolor="#E0F2FE", color="#0284C7"];
      b1 [label="SRAM Bank 1\n[Inputs A]",   fillcolor="#E0F2FE", color="#0284C7"];
      b2 [label="SRAM Bank 2\n[Outputs A]",  fillcolor="#E0F2FE", color="#0284C7"];
    }

    subgraph cluster_banks_B {
      label="Region B Allocated Banks"; color="#059669"; bgcolor="#F0FDF4";
      b3 [label="SRAM Bank 3\n[Weights B]", fillcolor="#DCFCE7", color="#059669"];
      b4 [label="SRAM Bank 4\n[Inputs B]",  fillcolor="#DCFCE7", color="#059669"];
    }
  }

  // Memory streaming connections
  b0 -> regA [label=" w_ld", color="#0284C7"];
  b1 -> regA [label=" din_w (act)", color="#0284C7"];
  regA -> b2 [label=" dout", color="#0284C7"];
  b3 -> regB [label=" w_ld", color="#059669"];
  b4 -> regB [label=" din_w_region_b", color="#059669"];

  // ==================== ARBITRATION & SECURITY LAYER ====================
  subgraph cluster_safety {
    label=<<B>Bandwidth Arbitration &amp; Hardware Security Substrate</B>>;
    fontsize=11; fontcolor="#1E293B";
    style="rounded,dashed"; color="#64748B"; bgcolor="#F8FAFC";

    eppa_arb [label="EPPA Bandwidth Arbiter\n(Event-Driven Phase-Pinned)\nBURST: 100% | STREAM: 50% | IDLE: 0%", fillcolor="#EEF2FF", color="#4F46E5", fontcolor="#312E81"];
    otp_fsm  [label="OTP Token FSM\n(Single-Writer Mutual Exclusion)\nEpoch Rotating Priority", fillcolor="#FFF1F2", color="#E11D48", fontcolor="#881337"];
    scrub_ctrl [label="Mandatory Bank Scrub\n(4-Cycle Active Zeroing)\nClears Residual Tenant Data", fillcolor="#FFF1F2", color="#E11D48", fontcolor="#881337"];
  }

  regA -> eppa_arb [label=" phase_tag_A", color="#0284C7"];
  regB -> eppa_arb [label=" phase_tag_B", color="#059669"];
  eppa_arb -> b0 [lhead=cluster_banks, label=" Dynamic BW Grant", color="#4F46E5", penwidth=1.5];

  regA -> otp_fsm [label=" token_req_A", dir=both, color="#0284C7"];
  regB -> otp_fsm [label=" token_req_B", dir=both, color="#059669"];
  otp_fsm -> scrub_ctrl [label=" trigger scrub"];
  scrub_ctrl -> b3 [label=" 4-cycle zeroing", color="#E11D48"];
}
