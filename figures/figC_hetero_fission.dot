// figC_hetero_fission.dot
// Configuration C: Novel Heterogeneous Fission Architecture (PolyFlow-NPU)
// Render: dot -Tpng -Gdpi=160 figC_hetero_fission.dot -o figC_hetero_fission.png

digraph FIG_C {
  graph [fontname="Helvetica,Arial,sans-serif", rankdir=TB, compound=true,
         label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                 <TR><TD><FONT POINT-SIZE="17"><B>Configuration C: Novel Heterogeneous Fission Architecture (PolyFlow-NPU)</B></FONT></TD></TR>
                 <TR><TD><FONT POINT-SIZE="11" COLOR="#475569">Concurrent Spatial Multi-Tenancy Composed with Independent Per-Region Dataflow Selection (WS ‖ OS)</FONT></TD></TR>
               </TABLE>>,
         labelloc=t, fontsize=14, pad=0.35, bgcolor="#FFFFFF"];

  node  [shape=box, style="rounded,filled", fontname="Helvetica,Arial,sans-serif", fontsize=10,
         fillcolor="#F8FAFC", color="#94A3B8", penwidth=1.2, margin="0.15,0.1"];
  edge  [fontname="Helvetica,Arial,sans-serif", fontsize=9, color="#475569", penwidth=1.2];

  // ==================== DISPATCH LAYER ====================
  subgraph cluster_dispatch {
    label=<<B>Multi-Tenant Host Controller &amp; Dynamic Fission Decoder</B>>;
    fontsize=11; fontcolor="#1E293B";
    style="rounded,dashed"; color="#94A3B8"; bgcolor="#F1F5F9";

    host_ctrl [label="Multi-Tenant Host Scheduler\nTenant A: CNN ResNet-50\nTenant B: Transformer Self-Attention",
               fillcolor="#FFFFFF", color="#64748B"];
    fiss_dec  [label="Dynamic Fission Decoder\n(cfg_split_col = 8)\nEmits: region_id_mask + reassign strobes",
               fillcolor="#EDE9FE", color="#7C3AED", fontcolor="#5B21B6"];

    host_ctrl -> fiss_dec [label=" Dispatch split & modes"];
  }

  // ==================== COMPUTE FABRIC ====================
  subgraph cluster_array {
    label=<<B>Heterogeneous Systolic Compute Fabric (16×16 PE Mesh)</B>>;
    fontsize=12; fontcolor="#0F172A";
    style="rounded"; color="#64748B"; bgcolor="#FAFAFA";

    regA [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#0284C7">
        <TR><TD COLSPAN="4" BGCOLOR="#0284C7"><FONT COLOR="#FFFFFF" POINT-SIZE="10"><B>Region A Sub-Array (Cols 0–7)</B></FONT></TD></TR>
        <TR><TD COLSPAN="4" BGCOLOR="#E0F2FE"><FONT POINT-SIZE="9">Dataflow: <B>Weight-Stationary (WS)</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#FFFFFF">PE[0,0]</TD><TD BGCOLOR="#FFFFFF">PE[0,1]</TD><TD BGCOLOR="#FFFFFF">…</TD><TD BGCOLOR="#FFFFFF">PE[0,7]</TD></TR>
        <TR><TD BGCOLOR="#FFFFFF">PE[1,0]</TD><TD BGCOLOR="#FFFFFF">PE[1,1]</TD><TD BGCOLOR="#FFFFFF">…</TD><TD BGCOLOR="#FFFFFF">PE[1,7]</TD></TR>
        <TR><TD COLSPAN="4" BGCOLOR="#F0F9FF"><FONT POINT-SIZE="8" COLOR="#0369A1"><B>CNN Workload:</B> Weights Stationary · Activations Stream</FONT></TD></TR>
      </TABLE>>, fillcolor="#FFFFFF", shape=plaintext];

    boundary_gate [label=<
      <TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#DC2626">
        <TR><TD BGCOLOR="#FEE2E2"><FONT COLOR="#991B1B" POINT-SIZE="9"><B>DYNAMIC<BR/>BOUNDARY<BR/>BARRIER</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#FEF2F2"><FONT POINT-SIZE="8" COLOR="#B91C1C">Active Zeroing<BR/>Cross-talk<BR/>Prevention</FONT></TD></TR>
      </TABLE>>, fillcolor="#FFFFFF", shape=plaintext];

    regB [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#D97706">
        <TR><TD COLSPAN="4" BGCOLOR="#D97706"><FONT COLOR="#FFFFFF" POINT-SIZE="10"><B>Region B Sub-Array (Cols 8–15)</B></FONT></TD></TR>
        <TR><TD COLSPAN="4" BGCOLOR="#FEF3C7"><FONT POINT-SIZE="9">Dataflow: <B>Output-Stationary (OS)</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#FFFFFF">PE[0,8]</TD><TD BGCOLOR="#FFFFFF">PE[0,9]</TD><TD BGCOLOR="#FFFFFF">…</TD><TD BGCOLOR="#FFFFFF">PE[0,15]</TD></TR>
        <TR><TD BGCOLOR="#FFFFFF">PE[1,8]</TD><TD BGCOLOR="#FFFFFF">PE[1,9]</TD><TD BGCOLOR="#FFFFFF">…</TD><TD BGCOLOR="#FFFFFF">PE[1,15]</TD></TR>
        <TR><TD COLSPAN="4" BGCOLOR="#FFFBEB"><FONT POINT-SIZE="8" COLOR="#B45309"><B>Attention Workload:</B> Q &amp; K Stream · Acc Stationary</FONT></TD></TR>
      </TABLE>>, fillcolor="#FFFFFF", shape=plaintext];

    pe_detail [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#4338CA">
        <TR><TD BGCOLOR="#4338CA"><FONT COLOR="#FFFFFF" POINT-SIZE="9"><B>hdf_pe Internal Microarchitecture</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT POINT-SIZE="8">
          • 3-Way Runtime Dataflow Mux (WS/OS/IS)<BR/>
          • 8-bit Signed Multiplier + 32-bit Acc<BR/>
          • Hardware Lifetime Countdown Register<BR/>
          • Bank Role Stale / Clear Handshake
        </FONT></TD></TR>
      </TABLE>>, fillcolor="#FFFFFF", shape=plaintext];

    {rank=same; regA; boundary_gate; regB;}
    regA -> boundary_gate [style=invis];
    boundary_gate -> regB [style=invis];
  }

  fiss_dec -> regA [label=" region 0: WS", color="#0284C7", penwidth=1.5];
  fiss_dec -> regB [label=" region 1: OS", color="#D97706", penwidth=1.5];
  fiss_dec -> boundary_gate [label=" isolate col 8", color="#DC2626"];
  regB -> pe_detail [style=dotted, label=" PE structure", arrowhead=none];

  // ==================== SHARED RECONFIGURABLE MEMORY ====================
  subgraph cluster_banks {
    label=<<B>Shared Dynamic Multi-Bank On-Chip SRAM Substrate</B>>;
    fontsize=11; fontcolor="#1E293B";
    style="rounded,dashed"; color="#D97706"; bgcolor="#FFFBEB";

    subgraph cluster_banks_A {
      label="Region A Allocated Banks (WS CNN)"; color="#0284C7"; bgcolor="#F0F9FF";
      b0 [label="SRAM Bank 0\n[Stationary Weights A]", fillcolor="#E0F2FE", color="#0284C7"];
      b1 [label="SRAM Bank 1\n[Streaming Act A / Out]", fillcolor="#E0F2FE", color="#0284C7"];
    }

    subgraph cluster_banks_B {
      label="Region B Allocated Banks (OS Attention)"; color="#D97706"; bgcolor="#FEFCE8";
      b2 [label="SRAM Bank 2\n[Streaming Q Matrix]", fillcolor="#FEF3C7", color="#D97706"];
      b3 [label="SRAM Bank 3\n[Streaming K Matrix]", fillcolor="#FEF3C7", color="#D97706"];
      b4 [label="SRAM Bank 4\n[Output Attention Map]", fillcolor="#FEF3C7", color="#D97706"];
    }
  }

  b0 -> regA [label=" w_ld", color="#0284C7"];
  b1 -> regA [label=" din_w (act)", color="#0284C7"];
  regA -> b1 [label=" dout", color="#0284C7"];

  b2 -> regB [label=" din_n (Q)", color="#D97706", penwidth=1.5];
  b3 -> regB [label=" din_w_b (K)", color="#D97706", penwidth=1.5];
  regB -> b4 [label=" dout (acc drain)", color="#D97706"];

  // ==================== ARBITRATION & SECURITY LAYER ====================
  subgraph cluster_safety {
    label=<<B>Bandwidth Optimization &amp; Hardware Security Substrate</B>>;
    fontsize=11; fontcolor="#1E293B";
    style="rounded,dashed"; color="#64748B"; bgcolor="#F8FAFC";

    eppa_arb [label="EPPA Bandwidth Arbiter\n(Event-Driven Phase-Pinned)\nDynamic Handover: Idle Region BW -> Streaming Region",
              fillcolor="#EEF2FF", color="#4F46E5", fontcolor="#312E81"];
    otp_fsm  [label="OTP Token FSM\n(Single-Writer Mutual Exclusion)\nEpoch Rotating Priority",
              fillcolor="#FFF1F2", color="#E11D48", fontcolor="#881337"];
    scrub_ctrl [label="Mandatory Bank Scrub\n(4-Cycle Active Zeroing)\nClears Residual Tenant Data",
                fillcolor="#FFF1F2", color="#E11D48", fontcolor="#881337"];
  }

  regA -> eppa_arb [label=" phase_tag_A (BURST/IDLE)", color="#0284C7"];
  regB -> eppa_arb [label=" phase_tag_B (STREAM)", color="#D97706"];
  eppa_arb -> b2 [lhead=cluster_banks, label=" Dynamic BW Rebalance", color="#4F46E5", penwidth=2];

  regA -> otp_fsm [label=" token_req_A", dir=both, color="#0284C7"];
  regB -> otp_fsm [label=" token_req_B", dir=both, color="#D97706"];
  otp_fsm -> scrub_ctrl [label=" trigger scrub"];
  scrub_ctrl -> b0 [label=" 4-cycle zeroing", color="#E11D48"];

  note_novelty [label="Novel Composite Advantage:\nRegion A runs CNN (WS) while Region B simultaneously runs Attention (OS)\nZero cross-region bleeding · Quasi-static EPPA memory bandwidth allocation",
                shape=note, fillcolor="#FEFCE8", color="#CA8A04", fontcolor="#854D0E", fontsize=9];
  note_novelty -> eppa_arb [style=dashed, arrowhead=none, color="#CA8A04"];
}
